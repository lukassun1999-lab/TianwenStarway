# 《天问·星途》后端环境变量模板
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# MiniMax API 密钥（对话模型 MiniMax-M2.7 使用）
LLM_API_KEY=your_minimax_api_key

# OpenMAIC 编排层地址（默认 http://localhost:3000）
OPENMAIC_BASE_URL=http://localhost:3000

# 是否尝试 OpenMAIC /api/chat 编排对话（"1" 开启，"0" 关闭直连 MiniMax）
# 已知 OpenMAIC /api/chat 会报 TypeError，默认关闭可省一次无效调用与 5 秒延迟
OPENMAIC_CHAT_ENABLED=0

# MiniMax 直连模型名
MINIMAX_MODEL=MiniMax-M2.7
