# 《天问·星途》后端环境变量模板
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# MiniMax API 密钥（对话模型使用；订阅密钥 与 按量计费 API key 不可互换）
LLM_API_KEY=your_minimax_api_key

# MiniMax 直连模型名
MINIMAX_MODEL=MiniMax-M2.7

# MiniMax 接口地址（两种端点都支持；换端点只改这一行，代码无需改动）
# 默认：Anthropic 兼容端点 —— 配合 Token Plan / Coding Plan 的「订阅密钥」使用
MINIMAX_URL=https://api.minimaxi.com/anthropic/v1/messages
# 按量计费：改用开放平台的「普通 API key」，把上面一行注释掉、启用下面这行
# MINIMAX_URL=https://api.minimaxi.com/v1/text/chatcompletion_v2
